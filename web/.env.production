VITE_API_BASE_URL=https://www.diantouai.com

# 客户端密钥需要与服务端 INTERVIEW_ASSISTANT_CLIENT_SECRET 保持一致。
VITE_CLIENT_SECRET=7784c8f005b822e81aa8531efd2d6510fb63c8b479996bf0072e47b37691c9fb

# 生产环境必须关闭模拟支付入口。
VITE_ENABLE_MOCK_PAYMENT=false
